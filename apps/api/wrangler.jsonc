{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbft",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat",
    "python_workers"
  ],
  "assets": {
    "directory": "../../data/processed/site",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mbft-d1",
      "database_id": "c5a92a61-6031-4c75-ba97-5727d5a81947"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "mbft-embeddings"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CF_LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAIL": ""
  }
}
