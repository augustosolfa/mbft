# Modelo de variáveis de ambiente do monorepo MBFT.
# Copie este arquivo para `.env` na raiz e preencha os valores reais.
# O `.env` é ignorado pelo Git (nunca versione segredos nem o domínio de produção).

# Chave da API Google Gemini usada pelo Gerador LLM local (`LLM_PROVIDER=gemini`).
GEMINI_API_KEY=seu-token-gemini

# Credenciais da Cloudflare usadas pelos subcomandos `mbft deploy` (dispensam `wrangler login`).
CLOUDFLARE_API_TOKEN=seu-token-cloudflare
CLOUDFLARE_ACCOUNT_ID=sua-account-id-cloudflare

# Hostname de produção do Worker único `mbft` (opcional).
# Quando definido, o deploy monta a rota <MBFT_HOSTNAME>/* e desativa o endereço workers.dev.
# Sem ele, o Worker permanece acessível apenas em <worker>.<conta>.workers.dev.
# A CLI (`--route`) tem precedência sobre este valor.
MBFT_HOSTNAME=seu-subdominio.seudominio.tld

# Cloudflare Access (PMS-011) - Opcional. Permite cotas ampliadas para usuários autenticados.
# Se vazias, todos os visitantes são limitados pela cota anônima (por IP).
ACCESS_TEAM_DOMAIN=seu-time.cloudflareaccess.com
ACCESS_AUD=sua-tag-aud-da-aplicacao

# Administrador do Sistema (/admin e /api/admin)
# E-mail verificado pelo Cloudflare Access autorizado a inspecionar as tabelas do D1.
ADMIN_EMAIL=meu@email.com

